import copy
import os
from itertools import product

import yaml

# =============================================================================
# GRIDS
# =============================================================================

GRID_VAE = {
    "lc":    [12, 24],            # latent_channel
    "cce":   [0.05, 0.15, 0.25],  # cce_weight 
    "vae_d": [0.1, 0.2],          # dropout VAE
}

GRID_DIT = {
    "nh":    [8, 16, 32],         # num_heads DiT 
    "nl":    [8],                 # num_layers DiT
    "dit_d": [0.1, 0.2],          # dropout DiT
    "cfg":   [0.5, 1.5],          # cfg_scale 
}

VAE_CONFIGS = [dict(zip(GRID_VAE.keys(), v)) for v in product(*GRID_VAE.values())]
DIT_CONFIGS = [dict(zip(GRID_DIT.keys(), v)) for v in product(*GRID_DIT.values())]

# =============================================================================
# IDs
# =============================================================================

def make_vae_id(cfg):
    return f"vae_lc{cfg['lc']}_cce{cfg['cce']}_d{cfg['vae_d']}"

def make_dit_id(cfg, vae_id):
    return (
        f"dit_nh{cfg['nh']}_nl{cfg['nl']}"
        f"_d{cfg['dit_d']}_cfg{cfg['cfg']}__{vae_id}"
    )

# --- Maps pour lookup dans les règles ---
VAE_MAP = {make_vae_id(c): c for c in VAE_CONFIGS}

DIT_MAP = {
    make_dit_id(d, make_vae_id(v)): {**d, **v}
    for d in DIT_CONFIGS
    for v in VAE_CONFIGS
}

# =============================================================================
# PATHS
# =============================================================================

VAE_DIR_TMPL = "runs/{run_id}"
DIT_DIR_TMPL = "runs/{run_id}"

def vae_dir(vae_id):  return VAE_DIR_TMPL.format(run_id=vae_id)
def dit_dir(dit_id):  return DIT_DIR_TMPL.format(run_id=dit_id)

def _vae_of(dit_id):
    """Extrait l'id VAE depuis l'id DiT (suffixe après '__')."""
    return dit_id.split("__", 1)[1]


# =============================================================================
# GLOBAL RULES
# =============================================================================

rule all:
    input:
        expand(
            "runs/{dit_id}/gen_data_dit.npy",
            dit_id=list(DIT_MAP.keys()),
        ),


# =============================================================================
# VAE (main + history)
# =============================================================================

rule vae_train:
    output:
        main_ckpt         = "runs/{vae_id}/vae_main_best.pth",
        history_ckpt      = "runs/{vae_id}/vae_history_best.pth",
        main_scaler       = "runs/{vae_id}/main_scaler.pkl",
        hist_scaler       = "runs/{vae_id}/hist_scaler.pkl",
        real_data_main    = "runs/{vae_id}/real_data_main.npy",
        gen_data_main     = "runs/{vae_id}/gen_data_main.npy",
        real_data_history = "runs/{vae_id}/real_data_history.npy",
        gen_data_history  = "runs/{vae_id}/gen_data_history.npy",
        main_vocab        = "runs/{vae_id}/main_vocab.json",
        hist_vocab        = "runs/{vae_id}/hist_vocab.json",
        main_cat_vocab    = "runs/{vae_id}/main_cat_vocab.json",
        hist_cat_vocab    = "runs/{vae_id}/hist_cat_vocab.json",
        config_yaml       = "runs/{vae_id}/config.yaml",
    log:
        "runs/{vae_id}/training.log",
    params:
        lc     = lambda w: VAE_MAP[w.vae_id]["lc"],
        cce    = lambda w: VAE_MAP[w.vae_id]["cce"],
        vae_d  = lambda w: VAE_MAP[w.vae_id]["vae_d"],
        outdir = lambda w: vae_dir(w.vae_id),
    run:
        from config import config as base_config

        cfg = copy.deepcopy(base_config.model_dump())
        outdir = params.outdir
        os.makedirs(outdir, exist_ok=True)

        # VAE main
        ae = cfg["autoencoder"]
        ae["latent_channel"]   = params.lc
        ae["cce_weight"]       = params.cce
        ae["dropout"]          = params.vae_d
        ae["checkpoint_path"]  = f"{outdir}/vae_main.pth"
        ae["best_model_path"]  = output.main_ckpt
        ae["scaler_path"]      = output.main_scaler

        # VAE history
        hae = cfg["history_autoencoder"]
        hae["latent_channel"]   = params.lc
        hae["cce_weight"]       = params.cce
        hae["dropout"]          = params.vae_d
        hae["checkpoint_path"]  = f"{outdir}/vae_history.pth"
        hae["best_model_path"]  = output.history_ckpt
        hae["hist_scaler_path"] = output.hist_scaler

        # Inference
        inf = cfg["inference"]
        inf["vae_real_path"]       = f"{outdir}/real_data"
        inf["vae_gen_path"]        = f"{outdir}/gen_data"
        inf["vae_evaluator_path"]  = f"{outdir}/"

        # Write the YAML specific to this run
        with open(output.config_yaml, "w") as f:
            yaml.safe_dump(cfg, f, sort_keys=False)

        # Sequential training
        shell(r"""
            set -e
            echo "=== VAE MAIN ===" >> {log}
            python -u train_VAE.py --mode main \
                --config {output.config_yaml} >> {log} 2>&1

            echo "=== VAE HISTORY ===" >> {log}
            python -u train_VAE.py --mode history \
                --config {output.config_yaml} >> {log} 2>&1

            echo "=== VAE completed ===" >> {log}
        """)


# =============================================================================
# STEP 2 — DiT, 1 run per DiT config, reuses the parent VAE
# =============================================================================

rule dit_train:
    input:
        main_ckpt         = lambda w: f"runs/{_vae_of(w.dit_id)}/vae_main_best.pth",
        history_ckpt      = lambda w: f"runs/{_vae_of(w.dit_id)}/vae_history_best.pth",
        main_scaler       = lambda w: f"runs/{_vae_of(w.dit_id)}/main_scaler.pkl",
        hist_scaler       = lambda w: f"runs/{_vae_of(w.dit_id)}/hist_scaler.pkl",
    output:
        latent_scale      = "runs/{dit_id}/latent_scale.npy",
        hist_latent_scale = "runs/{dit_id}/hist_latent_scale.npy",
        gen               = "runs/{dit_id}/gen_data_dit.npy",
        real              = "runs/{dit_id}/real_data_dit.npy",
        ckpt              = "runs/{dit_id}/diffusion_best.pth",
        config_yaml       = "runs/{dit_id}/config.yaml",
    log:
        "runs/{dit_id}/training.log",
    params:
        nh     = lambda w: DIT_MAP[w.dit_id]["nh"],
        nl     = lambda w: DIT_MAP[w.dit_id]["nl"],
        dit_d  = lambda w: DIT_MAP[w.dit_id]["dit_d"],
        cfg    = lambda w: DIT_MAP[w.dit_id]["cfg"],
        vae_id = lambda w: _vae_of(w.dit_id),
        outdir = lambda w: dit_dir(w.dit_id),
    run:
        from config import config as base_config

        vae_cfg = VAE_MAP[params.vae_id]
        cfg = copy.deepcopy(base_config.model_dump())
        outdir = params.outdir
        os.makedirs(outdir, exist_ok=True)
        
        # VAE configuration
        cfg["autoencoder"]["latent_channel"]   = vae_cfg["lc"]
        cfg["autoencoder"]["cce_weight"]       = vae_cfg["cce"]
        cfg["autoencoder"]["dropout"]          = vae_cfg["vae_d"]

        cfg["history_autoencoder"]["latent_channel"] = vae_cfg["lc"]
        cfg["history_autoencoder"]["cce_weight"]     = vae_cfg["cce"]
        cfg["history_autoencoder"]["dropout"]        = vae_cfg["vae_d"]

        # VAE (input)
        cfg["autoencoder"]["best_model_path"]          = input.main_ckpt
        cfg["autoencoder"]["scaler_path"]              = input.main_scaler
        cfg["history_autoencoder"]["best_model_path"]  = input.history_ckpt
        cfg["history_autoencoder"]["hist_scaler_path"] = input.hist_scaler

        # DiT parameters to vary
        dif = cfg["diffusion"]
        dif["num_heads"]  = params.nh
        dif["num_layers"] = params.nl
        dif["dropout"]    = params.dit_d
        dif["cfg_scale"]  = params.cfg

        # VAE files
        cfg["autoencoder"]["best_model_path"]          = input.main_ckpt
        cfg["autoencoder"]["scaler_path"]              = input.main_scaler
        cfg["history_autoencoder"]["best_model_path"]  = input.history_ckpt
        cfg["history_autoencoder"]["hist_scaler_path"] = input.hist_scaler

        dif["latent_scale_path"]      = output.latent_scale
        dif["hist_latent_scale_path"] = output.hist_latent_scale

        # DiT outputs
        dif["checkpoint_path"] = f"{outdir}/diffusion.pth"
        dif["best_model_path"] = output.ckpt

        # Inference section for train_DiT.py
        inf = cfg["inference"]
        inf["dit_real_path"]      = f"{outdir}/real_data_dit"
        inf["dit_gen_path"]       = f"{outdir}/gen_data_dit"
        inf["dit_evaluator_path"] = f"{outdir}/"

        # Write the YAML specific to this run
        with open(output.config_yaml, "w") as f:
            yaml.safe_dump(cfg, f, sort_keys=False)

        # Training
        shell(r"""
            set -e
            python -u train_DiT.py --config {output.config_yaml} > {log} 2>&1
        """)